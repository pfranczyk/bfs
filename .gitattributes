# Enforce LF line endings for all text files across Windows / macOS / Linux.
# Overrides local core.autocrlf so a fresh clone on Windows still gets LF -
# required for Biome to be green on every dev environment.
* text=auto eol=lf

# Windows-only executable scripts need CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Explicit binary markers (don't touch these at all).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.wasm binary

# Frozen backup written by a released version: every byte is part of the test.
tests/fixtures/v0-backup-0.14.4/** binary
